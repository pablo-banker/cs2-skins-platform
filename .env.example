# Environment variables for the CS2 Skins Platform.
#
# Copy this file to `.env` for local development. `.env` is git-ignored; this
# example file is not, and must never contain a real value.
#
# ---------------------------------------------------------------------------
# Conventions (see docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------------
#
#   PUBLIC_*   Readable in the browser via `$env/static/public`. Anything here is
#              shipped to every visitor. NEVER a secret.
#
#   everything else
#              Server-only, via `$env/static/private` or `$env/dynamic/private`.
#              Only ever imported from `src/lib/server/**`, a `+*.server.ts` file
#              or a `+server.ts` endpoint — never from a component.
#
# Marketplace/provider credentials (API keys, tokens, auth headers) are always
# private. A provider secret must never be given a PUBLIC_ prefix, and must never
# be hardcoded in source.
#
# ---------------------------------------------------------------------------
# Current variables
# ---------------------------------------------------------------------------

# CS2Cap API key. Private and server-only: it authenticates every catalog,
# price and history request in src/lib/server/providers/cs2cap/.
# Required — without it the integration fails with a config error.
# Never rename this to PUBLIC_CS2CAP_API_KEY: that prefix ships the value to
# every browser. Get a key at https://cs2cap.com/account/api-keys
CS2CAP_API_KEY=

# Whether this deployment may use CS2Cap's batch price lookup
# (POST /prices/batch). Operational configuration, not a secret — but still
# server-only, because which upstream endpoints a deployment may call is
# infrastructure and the browser has no business knowing it.
#
#   false  (default) Kit pricing loads each item individually, with bounded
#                    concurrency, reusing the existing 5-minute per-item cache.
#                    Correct for the free plan.
#   true             Kit pricing issues one batch request per kit.
#                    Requires a CS2Cap plan that includes batch lookups; on a
#                    plan without it upstream answers 403 and the market
#                    section degrades while the error stays diagnosable.
#
# There is no automatic probing: the mode is what this says it is.
CS2CAP_BATCH_PRICES_ENABLED=false

# Where CS2Cap lives. Leave blank in production — the integration defaults to
# the real API. It exists so the end-to-end suite can point the whole
# integration at a local stub, because CI must never need a real key.
#
#   (unset)                      https://api.cs2c.app/v1
#   http://localhost:4180/v1     the e2e stub in e2e/mock-cs2cap.mjs
CS2CAP_BASE_URL=

# ---------------------------------------------------------------------------
# Production runtime (adapter-node)
# ---------------------------------------------------------------------------
#
# These are read by the Node server the build produces, not by application
# code. None of them is a secret. See docs/DEPLOYMENT.md.

# The public URL the application is served from, scheme included and no
# trailing slash. adapter-node sits behind the host's TLS proxy and cannot
# infer this, and it is what canonical tags and copied share links are built
# from — get it wrong and every shared loadout links to the wrong host.
#
#   ORIGIN=https://<production-domain>
ORIGIN=

# Where the server listens. Most container hosts inject PORT; the Dockerfile
# defaults HOST to 0.0.0.0 so the container is reachable. Nothing in
# application code hardcodes either.
PORT=3000
HOST=0.0.0.0
